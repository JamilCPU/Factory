{
  "name": "factory-cli",
  "version": "0.1.0",
  "description": "Local AI coding assistant powered by Ollama — Copilot CLI for your workspace",
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/factory.mjs --banner:js=\"#!/usr/bin/env node\" --external:readline --external:child_process --external:fs --external:path",
    "start": "node dist/factory.mjs"
  },
  "bin": {
    "factory": "./dist/factory.mjs"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "diff": "^7.0.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
